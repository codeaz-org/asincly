# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://asincly:asincly@localhost:5432/asincly

# Auth.js
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# SSO providers (optional in dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID=
AUTH_MICROSOFT_ENTRA_SECRET=
AUTH_MICROSOFT_ENTRA_TENANT_ID=common

# S3-compatible object storage (MinIO in dev, R2 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=asincly
S3_SECRET_ACCESS_KEY=asincly-dev-secret
S3_BUCKET_RECORDINGS=asincly-recordings
S3_FORCE_PATH_STYLE=true

# AI providers
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Asincly <no-reply@asincly.local>

# Slack app
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Column-level encryption key (base64, 32 bytes)
DATA_ENCRYPTION_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
