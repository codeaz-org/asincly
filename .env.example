# Asincly configuration. Copy to `.env` and fill in.
# Full reference and hosting guides: docs/DEPLOYMENT.md
# Generate secrets with: openssl rand -base64 32   (or -hex 32 where noted)

# ─── App ────────────────────────────────────────────────────────────────
# Public URL of this deployment (used in emails, links and metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# AGPL-3.0 §13: link to the source of *this* deployment. If you modify
# Asincly, point this at your fork.
NEXT_PUBLIC_SOURCE_URL=https://github.com/codeaz-org/asincly

# ─── Database (Postgres 15+) ────────────────────────────────────────────
# DATABASE_URL: an owner/admin role that can bypass row-level security
# (superuser locally, the default owner role on Neon/Supabase). Used for
# migrations, Auth.js and trusted server-side reads.
DATABASE_URL=postgres://asincly:asincly@localhost:5433/asincly
# DATABASE_URL_APP: the non-superuser `asincly_app` role created by the
# migrations. RLS policies apply to it; social actions run through it.
DATABASE_URL_APP=postgres://asincly_app:asincly_app@localhost:5433/asincly
# Production: set this and run `pnpm db:migrate` to replace the development
# password of `asincly_app`, then use the same value in DATABASE_URL_APP.
APP_DB_PASSWORD=

# ─── Auth (Auth.js) ─────────────────────────────────────────────────────
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Set to true behind a reverse proxy (Docker self-host does this for you).
AUTH_TRUST_HOST=
# Optional Google sign-in. Magic links work without it.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Email (Resend) ─────────────────────────────────────────────────────
# Magic-link sign-in and notifications. Without a key in development the
# sign-in link is printed in the server log instead.
RESEND_API_KEY=
EMAIL_FROM=Asincly <no-reply@asincly.local>

# ─── Object storage (any S3-compatible: MinIO, Cloudflare R2, Backblaze B2) ─
# Browsers upload recordings directly with pre-signed URLs, so the endpoint
# must be reachable from users' browsers and allow CORS PUT from your app URL.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=asincly
S3_SECRET_ACCESS_KEY=asincly-dev-secret
S3_BUCKET_RECORDINGS=asincly-recordings
# true for MinIO; false for R2 and B2.
S3_FORCE_PATH_STYLE=true

# ─── Encryption ─────────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts transcripts, summaries and AI drafts at
# rest. Losing it makes that text unreadable — back it up.
DATA_ENCRYPTION_KEY=

# ─── AI (Groq) ──────────────────────────────────────────────────────────
# Whisper transcribes the audio track; Llama drafts yesterday/today/blockers
# against the author's previous plan and tags teammates it heard.
# Free key: https://console.groq.com. Without it, videos still upload and
# people write their check-in by hand.
GROQ_API_KEY=
# Development/tests only: deterministic fake transcription and drafts.
# Ignored when NODE_ENV=production.
AI_FAKE=

# ─── Scheduler ──────────────────────────────────────────────────────────
# Shared secret for /api/cron/tick (reminders, digests, retention purges).
# Call it every ~5 minutes: GitHub Actions (.github/workflows/cron.yml), the
# Docker `scheduler` service, or Vercel Cron on Pro. openssl rand -hex 32
CRON_SECRET=

# ─── Slack (optional) ───────────────────────────────────────────────────
# Channel digests and DM reminders. Create an app from the manifest in
# docs/SLACK.md; redirect URL: $NEXT_PUBLIC_APP_URL/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ─── Hosted cloud billing (leave unset when self-hosting) ───────────────
# Only the hosted Asincly Cloud sets this. Unset = every feature, no limits,
# no pricing page, no Stripe calls.
BILLING_ENABLED=
# Stripe (only read when BILLING_ENABLED=true). Prefer a restricted key
# (rk_...) with write access to Checkout Sessions, Customers, Subscriptions
# and the Billing Portal, and read access to Prices.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint $NEXT_PUBLIC_APP_URL/api/stripe/webhook
# (or from `stripe listen --forward-to localhost:3000/api/stripe/webhook`).
STRIPE_WEBHOOK_SECRET=
# Price ids printed by `node scripts/stripe-setup.mjs`. If empty, prices are
# looked up by their lookup keys.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Turn on only once you have active tax registrations in Stripe Tax.
# Without registrations Stripe collects no tax even with this on.
STRIPE_TAX_ENABLED=

# ─── Development ────────────────────────────────────────────────────────
# Extra hosts allowed to load the dev server, e.g. your LAN IP to test on a
# phone (192.168.0.10 or 192.168.*.*). Without it LAN pages never hydrate.
DEV_ALLOWED_ORIGINS=

# ─── Docker self-host only (docker-compose.selfhost.yml) ────────────────
POSTGRES_PASSWORD=
# With `--profile https`: DNS names pointing at the server. Caddy gets
# certificates automatically. Then use:
#   NEXT_PUBLIC_APP_URL=https://$APP_DOMAIN  AUTH_URL=https://$APP_DOMAIN
#   S3_ENDPOINT=https://$S3_DOMAIN
APP_DOMAIN=
S3_DOMAIN=
