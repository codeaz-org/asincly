# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Dev only: comma-separated hosts allowed to load the dev server besides
# localhost, e.g. your LAN IP to test on a phone (192.168.0.95 or 192.168.*.*).
# Without this, pages opened via the LAN IP render but never hydrate.
DEV_ALLOWED_ORIGINS=

# Postgres (matches docker-compose.yml)
# DATABASE_URL: superuser role. Used by drizzle-kit migrate and by the
# Auth.js adapter (magic-link + adapter flows need pre-auth writes).
DATABASE_URL=postgres://asincly:asincly@localhost:5433/asincly
# DATABASE_URL_APP: non-superuser role for all app queries. Row-Level
# Security policies check current_setting('app.current_user_id'), which
# is set per request by withUser() in src/db/with-user.ts.
DATABASE_URL_APP=postgres://asincly_app:asincly_app@localhost:5433/asincly

# Auth.js
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# SSO providers (optional in dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID=
AUTH_MICROSOFT_ENTRA_SECRET=
AUTH_MICROSOFT_ENTRA_TENANT_ID=common

# S3-compatible object storage (MinIO in dev, R2 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=asincly
S3_SECRET_ACCESS_KEY=asincly-dev-secret
S3_BUCKET_RECORDINGS=asincly-recordings
S3_FORCE_PATH_STYLE=true

# AI providers.
# Groq (free tier) powers video check-ins: Whisper transcribes the audio track,
# Llama drafts yesterday/today/blockers against the author's previous plan and
# tags teammates it heard. Get a key at https://console.groq.com.
# Without a key, videos still upload and people write their check-in by hand.
GROQ_API_KEY=
# Dev/test only: deterministic fake transcription + drafts (ignored in
# production). Used by e2e: AI_FAKE=1 pnpm dev, then AI_FAKE=1 pnpm e2e.
AI_FAKE=
# Optional. Present as fallbacks for teams that want a paid stack.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Asincly <no-reply@asincly.local>

# Slack app
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Column-level encryption key (base64, 32 bytes)
DATA_ENCRYPTION_KEY=

# Cron: shared secret for /api/cron/tick. In prod, hit that endpoint every
# few minutes from Vercel Cron / GitHub Actions / a cron on your self-host
# box. Generate with: openssl rand -hex 32
CRON_SECRET=

# Inngest (optional — the cron endpoint above does the same job for free)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
