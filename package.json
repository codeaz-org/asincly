{
  "name": "asincly",
  "version": "0.1.0",
  "description": "Async standups for remote teams: record a short video, AI writes the check-in, the team reads it in their own morning.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/codeaz-org/asincly#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/codeaz-org/asincly.git"
  },
  "bugs": {
    "url": "https://github.com/codeaz-org/asincly/issues"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "sh -c 'if [ \"$VERCEL_ENV\" = production ]; then node scripts/migrate.mjs; fi && next build'",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "emoji:sync": "node scripts/sync-emoji-data.mjs",
    "cron:local": "bash -c 'source .env && curl -sSf -H \"authorization: Bearer $CRON_SECRET\" http://localhost:3000/api/cron/tick && echo'",
    "db:seed": "node scripts/seed-demo.mjs",
    "db:rotate-key": "node --experimental-strip-types --no-warnings scripts/rotate-encryption-key.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "frimousse": "^0.4.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.32.1",
    "rrule": "^2.8.1",
    "stripe": "^22.6.2",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright-core": "^1.64.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=22.11"
  }
}
